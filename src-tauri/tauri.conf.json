{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "Minotaur",
    "version": "0.1.0",
    "identifier": "local.minotaur.app",
    "build": {
        "beforeDevCommand": "npm run dev",
        "devUrl": "http://127.0.0.1:5173",
        "beforeBuildCommand": "npm run build",
        "frontendDist": "../dist"
    },
    "app": {
        "windows": [
            {
                "title": "Minotaur",
                "width": 1080,
                "height": 760,
                "minWidth": 760,
                "minHeight": 600,
                "visible": false
            },
            {
                "label": "splash",
                "title": "Minotaur",
                "url": "splash.html",
                "width": 420,
                "height": 300,
                "center": true,
                "decorations": false,
                "resizable": false,
                "alwaysOnTop": true,
                "skipTaskbar": true,
                "backgroundColor": "#f5f7f5"
            }
        ],
        "security": {
            "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
        }
    },
    "bundle": {
        "active": false,
        "targets": [
            "nsis"
        ],
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.ico"
        ]
    }
}
